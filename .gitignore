# Temporary files - do not commit
_tmp/

# Environment and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/

# SQLite database
data/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
# Agent settings stay local; the shared skills symlink is tracked
.claude/*
!.claude/skills

# Agent handoffs (session state, never committed)
_handoff/
